# ---- LiveKit (free: https://cloud.livekit.io -> project -> Settings -> Keys) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Self-hosted alternative: run `livekit-server --dev` and use
# LIVEKIT_URL=ws://localhost:7880  LIVEKIT_API_KEY=devkey  LIVEKIT_API_SECRET=secret

# ---- Providers (each stage is swappable) ----
STT_PROVIDER=groq          # groq (Whisper, free tier) | sarvam (Indian-accent English)
LLM_PROVIDER=groq          # groq (gpt-oss-120b, free tier) | gemini (needs an AI Studio key)
TTS_PROVIDER=elevenlabs    # elevenlabs | sarvam (Indian Hindi voices)

GROQ_API_KEY=              # https://console.groq.com/keys      (STT, and LLM if LLM_PROVIDER=groq)
GOOGLE_API_KEY=            # https://aistudio.google.com/apikey (Gemini)
ELEVEN_API_KEY=            # https://elevenlabs.io              (TTS)
SARVAM_API_KEY=            # https://dashboard.sarvam.ai        (only if using sarvam)

# ---- Optional tuning ----
# GEMINI_MODEL=            # empty = LiveKit plugin default Flash model
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# ELEVEN_MODEL=eleven_flash_v2_5
# ELEVEN_VOICE_ID=         # any ElevenLabs voice; flash/turbo v2.5 speak Hindi with any voice
# SARVAM_SPEAKER=
# TTS_SPEED=1.05
# TURN_DETECTOR=multilingual   # multilingual (LiveKit inference end-of-sentence model) | vad (silence only)
# VAD_MIN_SILENCE=0.45
# MIN_ENDPOINT_DELAY=0.4
# MAX_ENDPOINT_DELAY=2.5
# INCOMPLETE_HOLD_SECONDS=1.2
# OVERLAP_MODE=interrupt       # interrupt (barge-in stops Hindi) | queue (interpreter style)
